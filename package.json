{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "oxlint apps packages scripts vite.config.ts --deny-warnings --type-aware",
    "test": "node --import ./scripts/register-ts-loader.mjs --test 'packages/**/*.test.ts'",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@tarstate/core": "link:../tarstate/packages/core"
    }
  }
}
