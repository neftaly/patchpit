{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "artifacts:build": "node scripts/build-artifacts.mts",
    "artifacts:check": "node scripts/build-artifacts.mts --check",
    "build": "pnpm artifacts:check && vite build",
    "build:sandbox-compat": "vite build --config apps/sandbox-compat/vite.config.ts",
    "dev": "vite",
    "fixtures:patchwork": "node --import ./tests/support/register-ts-loader.mjs scripts/generate-patchwork-fixtures.mts",
    "lint": "oxlint apps packages scripts src tests vite.config.ts --deny-warnings --type-aware",
    "test": "node tests/run.mjs",
    "test:behavior": "node tests/run.mjs behavior",
    "test:dev": "node --import ./tests/support/register-ts-loader.mjs tests/browser/prototype-preview.mjs --dev",
    "test:fuzz": "node tests/run.mjs fuzz",
    "test:integration": "node tests/run.mjs integration",
    "test:markdown-editor": "node tests/browser/markdown-editor.mjs",
    "test:preview": "node --import ./tests/support/register-ts-loader.mjs tests/browser/prototype-preview.mjs",
    "preview": "vite preview",
    "typecheck": "pnpm artifacts:check && tsc"
  },
  "dependencies": {
    "@automerge/automerge": "3.2.6",
    "@automerge/automerge-repo": "2.5.6",
    "@automerge/automerge-repo-network-broadcastchannel": "catalog:",
    "@neftaly/editcontext-polyfill": "0.1.1",
    "@patchpit/artifacts": "workspace:*",
    "@patchpit/automerge-fs": "workspace:*",
    "@patchpit/fs": "workspace:*",
    "@patchpit/sandbox": "workspace:*",
    "@patchpit/sandbox-fs": "workspace:*",
    "@tarstate/automerge": "catalog:tarstate",
    "@tarstate/core": "catalog:tarstate",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tarstate/schema-tools": "catalog:tarstate",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
