{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "oxlint apps packages scripts src vite.config.ts --deny-warnings --type-aware",
    "test": "node --import ./scripts/register-ts-loader.mjs --test 'packages/**/*.test.ts'",
    "test:browser": "node --import ./scripts/register-ts-loader.mjs scripts/test-sandbox-compat.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@patchpit/sandbox": "workspace:*",
    "@patchpit/sandbox-fs": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "catalog:"
  }
}
