{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @patchpit/hello-world dev",
    "fixtures:check": "pnpm fixtures:seed && git diff --exit-code -- apps/hello-world/src/fixtures/seed.ts",
    "fixtures:seed": "node scripts/generate-seed-fixture.mjs",
    "lint": "oxlint . --deny-warnings --type-aware",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-top-level-await": "catalog:",
    "vite-plugin-wasm": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@tarstate/core": "git+https://github.com/neftaly/tarstate.git#c40c8e360b22f1a9f1832fbafd2e9359500307ba&path:/packages/core"
    }
  }
}
