{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "prebuild": "pnpm generate:hello-world-fixtures",
    "dev": "vite",
    "generate:hello-world-fixtures": "pnpm --filter @patchpit/hello-world build && node scripts/generate-hello-world-dist.mjs",
    "check:hello-world-fixtures": "pnpm --filter @patchpit/hello-world build && node scripts/generate-hello-world-dist.mjs --check",
    "lint": "oxlint apps packages scripts src vite.config.ts --deny-warnings --type-aware",
    "test": "node --import ./scripts/register-ts-loader.mjs --test 'packages/**/*.test.ts'",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@automerge/automerge-repo": "catalog:",
    "@patchpit/automerge-fs": "workspace:*",
    "@patchpit/sandbox-fs": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "catalog:"
  }
}
