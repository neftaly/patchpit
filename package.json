{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@tarstate/core": "https://github.com/neftaly/tarstate/releases/download/v0.4.0/tarstate-core-0.4.0.tgz"
    }
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build",
    "build:sandbox-compat": "vite build --config apps/sandbox-compat/vite.config.ts",
    "dev": "vite",
    "lint": "oxlint apps packages src tests vite.config.ts --deny-warnings --type-aware",
    "test": "node tests/run.mjs",
    "test:behavior": "node tests/run.mjs behavior",
    "test:dev": "node --import ./tests/support/register-ts-loader.mjs tests/browser/prototype-preview.mjs --dev",
    "test:fuzz": "node tests/run.mjs fuzz",
    "test:integration": "node tests/run.mjs integration",
    "test:preview": "node --import ./tests/support/register-ts-loader.mjs tests/browser/prototype-preview.mjs",
    "preview": "vite preview",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@automerge/automerge": "3.2.6",
    "@automerge/automerge-repo": "2.5.6",
    "@patchpit/automerge-fs": "workspace:*",
    "@patchpit/fs": "workspace:*",
    "@patchpit/sandbox": "workspace:*",
    "@patchpit/sandbox-fs": "workspace:*",
    "@tarstate/automerge": "https://github.com/neftaly/tarstate/releases/download/v0.4.0/tarstate-automerge-0.4.0.tgz",
    "@tarstate/core": "https://github.com/neftaly/tarstate/releases/download/v0.4.0/tarstate-core-0.4.0.tgz",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
