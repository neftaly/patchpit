{
  "name": "patchpit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.ts --logLevel warn",
    "dev": "vite --config vite.config.ts",
    "fixtures:check": "pnpm fixtures:seed && git diff --exit-code -- packages/system/src/fixtures/seed.ts",
    "fixtures:seed": "node scripts/generate-seed-fixture.mjs",
    "lint": "oxlint . --deny-warnings --type-aware",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-top-level-await": "catalog:",
    "vite-plugin-wasm": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@tarstate/core": "git+https://github.com/neftaly/tarstate.git#83a8792e5724cd05ec878540ff3f25442731faf2&path:/packages/core"
    },
    "patchedDependencies": {
      "@automerge/automerge-repo@2.5.6": "patches/@automerge__automerge-repo@2.5.6.patch"
    }
  }
}
